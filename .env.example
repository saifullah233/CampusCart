# CampusCart Backend — environment template.
#
# Copy to `.env` (which is git-ignored) and fill in real values:
#     cp .env.example .env
#
# Docker Compose reads `.env` automatically. For `mvn spring-boot:run`, export these
# in your shell instead. NEVER commit a real `.env`. Required values have NO
# source-controlled default and the app/compose fail fast if they are missing.

# ────────────────────────────────────────────────────────────────────────────
# REQUIRED — database (MySQL)
# ────────────────────────────────────────────────────────────────────────────
# Root password for the MySQL container (Compose only).
MYSQL_ROOT_PASSWORD=change-me-root
# Application database + user created by the MySQL container.
MYSQL_DATABASE=campuscart
MYSQL_USER=campuscart
MYSQL_PASSWORD=change-me-app
# Password the application uses to connect. MUST equal MYSQL_PASSWORD above.
DB_PASSWORD=change-me-app

# OPTIONAL — datasource overrides.
# Local run defaults to jdbc:mysql://localhost:3306/campuscart; the `docker`
# profile defaults to the `mysql` compose service host. Override only if needed.
# DB_URL=jdbc:mysql://localhost:3306/campuscart
# DB_USERNAME=campuscart

# ────────────────────────────────────────────────────────────────────────────
# REQUIRED — JWT signing
# ────────────────────────────────────────────────────────────────────────────
# HS256 signing secret. MUST be a random value of at least 32 characters.
# Generate one, e.g.:  openssl rand -base64 48
JWT_SECRET=Jchange-me-to-a-random-string-of-at-least-32-characters
# OPTIONAL — token issuer + lifetimes.
JWT_ISSUER=campuscart
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d

# ────────────────────────────────────────────────────────────────────────────
# REQUIRED for browsers — CORS
# ────────────────────────────────────────────────────────────────────────────
# Comma-separated exact frontend origins. Wildcards are rejected at startup.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Cloudinary image storage
# ────────────────────────────────────────────────────────────────────────────
# With enabled=false the app starts, but product/chat image upload returns a safe
# configuration error until real credentials are supplied and enabled=true.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# OPTIONAL — OTP policy (registration verification)
# ────────────────────────────────────────────────────────────────────────────
# NOTE: outbound OTP delivery (email/SMS) requires a deployment-provided adapter
# implementing OtpDeliveryGateway. Without it, codes are generated and verified
# but never sent to end users. See docs/deployment/README.md.
OTP_TTL=5m
OTP_RESEND_COOLDOWN=60s
OTP_RATE_WINDOW=15m
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_WINDOW=5
OTP_CODE_LENGTH=6

# ────────────────────────────────────────────────────────────────────────────
# OPTIONAL — login abuse throttling
# ────────────────────────────────────────────────────────────────────────────
LOGIN_MAX_FAILURES=5
LOGIN_RATE_WINDOW=15m
LOGIN_LOCKOUT=15m

# ────────────────────────────────────────────────────────────────────────────
# REAL OUTBOUND OTP DELIVERY — EMAIL (SMTP)
# ────────────────────────────────────────────────────────────────────────────
# To deliver real OTP emails to student/community user inboxes:
# For Gmail SMTP:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=campuscartservice01@gmail.com
#   MAIL_PASSWORD=idxt tkor vnza rbmh
#   MAIL_FROM=campuscartservice01@gmail.com
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
#
# For SendGrid / Brevo / Mailgun / AWS SES:
#   MAIL_HOST=smtp.sendgrid.net (or smtp-relay.brevo.com)
#   MAIL_PORT=587
#   MAIL_USERNAME=apikey
#   MAIL_PASSWORD=your-sendgrid-or-brevo-smtp-key
#   MAIL_FROM=verify@yourcampuscartdomain.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=campuscartservice01@gmail.com
MAIL_PASSWORD=idxt tkor vnza rbmh
MAIL_FROM=noreply@campuscart.local
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ────────────────────────────────────────────────────────────────────────────
# REAL OUTBOUND OTP DELIVERY — WHATSAPP (Fast2SMS WhatsApp API)
# ────────────────────────────────────────────────────────────────────────────
# Primary: Fast2SMS WhatsApp Gateway (Sends OTP to Indian mobile numbers via WhatsApp)
# Get your API Key from https://www.fast2sms.com
FAST2SMS_API_KEY=

# OPTIONAL: Custom Fast2SMS WhatsApp Template / Phone Number IDs (if using custom templates)
FAST2SMS_WHATSAPP_MESSAGE_ID=
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=

# ────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Spring profile. Compose sets `docker`; leave unset for local runs.
# ────────────────────────────────────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=docker
